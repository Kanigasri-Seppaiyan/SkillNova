# ============================================================
# SkillNova Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# ============================================================

DATABASE_URL=sqlite:///./skillnova.db
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:5500,http://localhost:5500

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
ALLOWED_EMAIL_DOMAIN=bitsathy.ac.in

# ── OpenAI (server-side only) ─────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
