# ============================================================
# Smart AI Career Companion — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=skillnova
POSTGRES_PASSWORD=skillnova_secret
POSTGRES_DB=skillnova

# ── Backend ───────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
ALLOWED_EMAIL_DOMAIN=bitsathy.ac.in

# ── Admin Access Control ──────────────────────────────────────
# Reserve single authorized administrator email.
# Store the authorized Admin email in backend env var only, never hardcoded.
SKILLNOVA_ADMIN_EMAIL=skillnova.admin@gmail.com

# ── OpenAI (server-side only — NEVER expose to frontend) ─────
# Leave empty to run in stub/deterministic mode (all other features work)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Frontend (must start with VITE_ prefix) ───────────────────
# Point to public API and Google Client ID (client id is public, secret is NEVER on frontend)
VITE_API_BASE_URL=http://localhost:8000/api
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
