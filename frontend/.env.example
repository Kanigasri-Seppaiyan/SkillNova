# SkillNova Frontend Environment Variables
# Copy this file to .env or .env.local and fill in your actual values.
# Vite exposes variables prefixed with VITE_ to client code.

# Backend API Base URL (FastAPI backend running on port 8000)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# ── Google OAuth Client ID ──────────────────────────────────────────────────
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Select your project → APIs & Services → Credentials
# 3. Create OAuth 2.0 Client ID (Application Type: "Web application")
# 4. Authorized JavaScript origins:
#    - http://localhost:3000
#    - http://127.0.0.1:3000
# 5. Copy the Client ID below:
VITE_GOOGLE_CLIENT_ID=your-actual-client-id.apps.googleusercontent.com

# NOTE: Vite loads environment variables at startup.
# If you edit this file or .env, restart the dev server with `npm run dev`.
